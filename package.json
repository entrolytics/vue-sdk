{
  "name": "@entrolytics/vue-sdk",
  "version": "3.0.2",
  "description": "Vue SDK for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "entrolytics",
    "tracking",
    "vue",
    "vue3",
    "web-analytics"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/vue-sdk/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/vue-sdk",
    "directory": "entro-vue"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "vue": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --noEmit false",
    "check": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix . && oxfmt --write .",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.2.1"
  },
  "devDependencies": {
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsdown": "^0.23.7",
    "typescript": "next",
    "vue": "^3.5.46"
  },
  "peerDependencies": {
    "vue": ">=3.5.28",
    "vue-router": ">=5.0.2"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "packageManager": "pnpm@12.23.0"
}
